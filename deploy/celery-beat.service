# /etc/systemd/system/celery-beat.service
[Unit]
Description=Habit Tracker Celery Beat
After=network.target redis.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/habit_tracker
EnvironmentFile=/home/ubuntu/habit_tracker/.env
ExecStart=/home/ubuntu/habit_tracker/venv/bin/celery -A config beat -l info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
